# ── required ─────────────────────────────────────────────────────────────────

# Model access, via OpenRouter. Any structured-output-capable model works; the
# default (deepseek-v4-flash, reasoning off, fastest hosts pinned) was chosen
# by bake-off — five configs, one company, one table: runs a full map at
# ~$0.001 per entity. The engine names the model on every span it bills.
OPENROUTER_API_KEY=

# Web access, via Bright Data. The token comes from Account settings → API keys
# on the SAME account that owns the zones below. SERP zone accepts a
# comma-separated list and the client rotates across them.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# ── optional ─────────────────────────────────────────────────────────────────

# Basic auth for the hosted web app. Unset = the app is open.
KB_USER=
KB_PASSWORD=

# Read-only demo. `1` turns it on. POST /api/map refuses with a friendly
# sentence instead of starting a run, and the gallery serves the six maps
# committed under demo/maps/ instead of runs/. Every read route is untouched, so
# the maps, the graph, the notes and the export all work.
#
# This is what makes a public URL safe to hand to strangers: a live run is four
# to nineteen minutes and $0.30-$5.00, and auth plus a ceiling only bound who
# and how much. Unset = the app builds maps as it always has.
#
# OPENKB_RUNS_DIR is NOT consulted in demo mode — that one says where new runs
# are written, and a demo writes none. To serve a different set of maps, point
# OPENKB_DEMO_MAPS_DIR at the directory. Unset, the app finds demo/maps/ itself.
OPENKB_DEMO=
OPENKB_DEMO_MAPS_DIR=

# The spend brake. The web app refuses to start a run once the OpenRouter key's
# cumulative usage since BASE exceeds the ceiling. Set BASE to the key's usage
# at deploy time (DEPLOY.md shows the one-line read); unset = no ceiling.
OPENKB_CEILING_USD=
OPENKB_CEILING_BASE_USD=

# Model override for the CLI scripts.
OPENKB_MODEL=

# Run persistence. Without these, runs are files under runs/ and a crashed run
# loses whatever it had not finished. With them, spans are written as they
# happen, so a dead run stays readable and a restarted server can still serve
# it. Schema: scripts/supabase-schema.sql
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── speed dials (optional; measured defaults ship in code) ───────────────────

# Width of the rank pool — how many hosts are judged at once. 8 is the proven
# default; 24 measured ~3x the phase throughput with no provider pushback.
OPENKB_RANK_CONCURRENCY=

# Width of the SERP wave. 20 default; 32 measured fine on one zone — but two
# CONCURRENT runs share the zone, and a saturated wave reads as an empty round.
OPENKB_SEARCH_CONCURRENCY=

# Swarm lanes (investigators in flight). 6 is the design's number; 10 measured.
OPENKB_SWARM_LANES=

# Swarm wall clock in ms (default 600000) and per-tier model overrides.
OPENKB_SWARM_WALL=
OPENKB_SWARM_LEAD_MODEL=
OPENKB_SWARM_PEEK_MODEL=
OPENKB_SWARM_READ_MODEL=
OPENKB_SWARM_DIG_MODEL=
